# ============================================================================
# FidelizOn v2.0 — Configurações de Ambiente (.env)
# ============================================================================

# ----------------------------------------------------------------------------
# 1. VARIÁVEIS PÚBLICAS DO FRONTEND (Empacotadas pelo Vite para o GitHub Pages)
# ----------------------------------------------------------------------------

# Thirdweb Client ID (Chave pública para conexões Web3 e In-App Wallets)
# Obtenha em: https://thirdweb.com/dashboard/settings/api-keys
VITE_THIRDWEB_CLIENT_ID=your_thirdweb_client_id_here

# Rede Ativa: 'base-sepolia' para testes/homologação ou 'base' para produção
VITE_ACTIVE_CHAIN=base-sepolia

# Sanity CMS: ID do Projeto e Dataset (Públicos para leitura via Sanity CDN)
# Obtenha em: https://www.sanity.io/manage
VITE_SANITY_PROJECT_ID=your_sanity_project_id_here
VITE_SANITY_DATASET=production

# ----------------------------------------------------------------------------
# 2. CREDENCIAIS PRIVADAS DE SERVIÇO (NUNCA expor no GitHub Pages nem prefixar com VITE_)
# Usadas apenas em scripts locais (seed), API Serverless ou CI/CD
# ----------------------------------------------------------------------------

# Token de Escrita do Sanity (Permissão de escrita para provisionamento de tenants/produtos)
# SANITY_API_WRITE_TOKEN=sk_your_sanity_secret_write_token_here

# Thirdweb Secret Key (Usada pelo script de deploy de contratos e pelo Thirdweb Engine)
# THIRDWEB_SECRET_KEY=your_thirdweb_secret_key_here

# Chave Privada do Deployer (Usada para assinar deploy de contratos na Base/Base Sepolia via terminal)
# ADMIN_PRIVATE_KEY=0x_your_64_hex_chars_private_key_here
