{
  "name": "fidelizon-monorepo",
  "version": "2.0.0",
  "private": true,
  "description": "Monorepo da plataforma FidelizOn v2.0 (SaaS B2B2C Web3)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@fidelizon/web",
    "dev:cliente": "npm run dev --workspace=@fidelizon/web -- --port 5173",
    "dev:caixa": "npm run dev --workspace=@fidelizon/web -- --port 5174",
    "dev:dual": "npx concurrently -k -n \"CLIENTE,CAIXA\" -c \"green,blue\" \"npm run dev:cliente\" \"npm run dev:caixa\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspaces --if-present",
    "create-wallet": "tsx scripts/create-wallet.ts",
    "deploy:contract": "tsx scripts/deploy-contract.ts",
    "domain:setup": "tsx scripts/configure-domain-cors.ts",
    "roles:configure": "tsx scripts/configure-roles.ts",
    "tokens:init": "tsx scripts/init-tokens.ts",
    "seed:sanity": "npx sanity datasets import ./packages/sanity-schemas/data/seed-cafeteria-aroma.ndjson production --project=8fgufitv --replace",
    "prepare": "husky"
  },
  "keywords": [
    "loyalty",
    "web3",
    "thirdweb",
    "sanity",
    "pwa",
    "erc4337",
    "github-pages"
  ],
  "author": "FidelizOn Team",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^26.6.10",
    "husky": "^9.1.7",
    "tsx": "^4.23.15"
  }
}
